# Variables de l'application — copier en « .env » pour le développement local (jamais commité).
# En production : Vercel > Project > Settings > Environment Variables ; Supabase > Edge Functions > Secrets.

# ---------- Vercel (API Python + fonction Word)
# Supabase : URL et clés du projet (Project Settings > API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (jamais dans le front, jamais dans Git)
SUPABASE_SERVICE_ROLE_KEY=
# Secret aléatoire (48+ caractères) : jetons conseillers + protection de /api/docx
SECRET_KEY=
# Secret de la tâche planifiée Vercel Cron (/api/cron/purge)
CRON_SECRET=
# IA (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free
OPENROUTER_DATA_COLLECTION=allow
# Fonction limitée à 300 s : délai par appel et budget total de l'étape IA
LLM_TIMEOUT=75
LLM_BUDGET=170
# Espace conseiller : « email=motdepasse » séparés par « ; »
ADMIN_ACCOUNTS=
# Facultatif : URL du rendu Word (par défaut https://<domaine>/api/docx sur Vercel, Node local sinon)
DOCX_RENDER_URL=
# Facultatif
# RATE_LIMIT_PER_HOUR=5
# EVENT_DAYS=2026-12-16,2026-12-17,2026-12-18

# ---------- Supabase > Edge Functions > Secrets (fonction envoyer-rapport)
# RESEND_API_KEY=            (clé API Resend)
# MAIL_FROM=DC-KNOWING · Diagnostic JPO <diagnostic@dc-knowing.com>
# MAIL_COPY_TO=              (copie interne, adresses séparées par des virgules)
# PUBLIC_SITE_URL=https://jpo-checkup.vercel.app
