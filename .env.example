# Variables de l'application — copier en « .env » pour le développement local (jamais commité).
# En production : Vercel > Project > Settings > Environment Variables (Production) ; Supabase > Edge Functions > Secrets.
# Préversions (Preview) : mêmes noms, mais valeurs d'un projet Supabase de TEST (voir DEPLOIEMENT.md §7).

# ---------- Vercel (API Python + fonction Word)
# Supabase : URL et clés du projet (Project Settings > API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (jamais dans le front, jamais dans Git) — OBLIGATOIRE en production
SUPABASE_SERVICE_ROLE_KEY=
# Secret aléatoire (48+ caractères) : jetons conseillers + protection de /api/docx — OBLIGATOIRE en production
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Secret de la tâche planifiée Vercel Cron (/api/cron/purge), 16+ caractères — OBLIGATOIRE en production
CRON_SECRET=
# Secret partagé avec l'Edge Function envoyer-rapport (même valeur dans Supabase > Edge Functions > Secrets)
EDGE_INTERNAL_SECRET=

# IA (OpenRouter) — OBLIGATOIRE en production
OPENROUTER_API_KEY=
# Modèles PAYANTS, sans conservation des données (les modèles « :free » imposent la collecte : refusés en production).
# Exemple de format : fournisseur/modele-1,fournisseur/modele-2 (ordre de repli)
OPENROUTER_MODELS=
# « deny » : seuls les fournisseurs qui ne conservent pas les données sont utilisés (notice ARTCI). Ne pas changer.
OPENROUTER_DATA_COLLECTION=deny
# Fonction limitée à 300 s : délai par appel et budget total de l'étape IA (valeurs par défaut du code)
LLM_TIMEOUT=75
LLM_BUDGET=170

# Espace conseiller : « email=empreinte[,totp=CLE][,role=lecture] » séparés par « ; »
#   empreinte : python -m app.security hash   ·   clé TOTP : python -m app.security totp prenom.nom@dc-knowing.com
# Mots de passe en clair : acceptés en local seulement (refusés en production).
ADMIN_ACCOUNTS=
# Durée des sessions conseillers (heures) ; changer ADMIN_TOKEN_VERSION déconnecte tous les conseillers
# ADMIN_TOKEN_HOURS=4
# ADMIN_TOKEN_VERSION=1

# Supervision (facultatif) : erreurs envoyées à Sentry, sans données personnelles
SENTRY_DSN=

# Facultatif : URL du rendu Word (par défaut https://<domaine>/api/docx sur Vercel, Node local sinon)
DOCX_RENDER_URL=
# Facultatif : limites et rétention (valeurs par défaut)
# RATE_LIMIT_PER_HOUR=5        dépôts par visiteur et par heure
# MAX_TOTAL_MB=50              taille totale d'un dépôt
# MAX_USER_MB_JOUR=200         volume envoyé par visiteur et par 24 h
# MAX_FICHIERS_HEURE=30        fichiers envoyés par visiteur et par heure
# RETENTION_RAW_HOURS=24       fichiers bruts
# RETENTION_REPORT_DAYS=30     dossiers et rapports
# RETENTION_AUDIT_DAYS=365     journal d'audit
# EMAILS_PREVIEW=0             1 = autoriser les e-mails réels sur une préversion (déconseillé)
# MAX_TENTATIVES=2            tentatives de traitement (reprise automatique) avant erreur
# EVENT_DAYS=2026-12-16,2026-12-17,2026-12-18
# Antivirus ClamAV (facultatif) : démon clamd joignable depuis Vercel
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_OBLIGATOIRE=0         1 = bloquer le traitement si l'antivirus ne répond pas

# ---------- Supabase > Edge Functions > Secrets (fonction envoyer-rapport)
# RESEND_API_KEY=            (clé API Resend)
# MAIL_FROM=DC-KNOWING · Diagnostic JPO <diagnostic@dc-knowing.com>
# MAIL_COPY_TO=              (copie interne, adresses séparées par des virgules)
# PUBLIC_SITE_URL=https://jpo-checkup-itdcknowing-5466s-projects.vercel.app
# EDGE_INTERNAL_SECRET=      (même valeur que dans Vercel)
# EMAILS_PAR_HEURE=10
