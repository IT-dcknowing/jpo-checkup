# Copier ce fichier en « .env » puis renseigner au minimum OPENROUTER_API_KEY et ADMIN_PASSWORD.

# --- IA (OpenRouter) : modèles gratuits essayés dans cet ordre, repli automatique si l'un échoue
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free
# Les modèles gratuits demandent « allow ». Le texte envoyé est anonymisé (noms, NCC, RIB, e-mails, téléphones).
OPENROUTER_DATA_COLLECTION=allow

# --- Espace conseiller (désactivé tant que ADMIN_PASSWORD est vide)
ADMIN_USER=conseiller
ADMIN_PASSWORD=

# --- Adresse publique de l'API (liens de téléchargement dans l'e-mail) et origines autorisées (front)
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- E-mail (sans SMTP_HOST, le rapport est produit mais pas envoyé)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=diagnostic@dc-knowing.com
# Copie interne au conseiller du jour (adresses séparées par des virgules)
MAIL_COPY_TO=

# --- Facultatif
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# WORKERS=4
# RATE_LIMIT_PER_HOUR=5
# EVENT_DAYS=2026-12-16,2026-12-17,2026-12-18
