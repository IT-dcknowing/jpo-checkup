{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -rf public && cp -R checkup360-front/checkup360-front public && rm -rf public/references public/README.md",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": "public",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/app/**,moteur_rapport.py,word/generer_rapport.py}",
      "excludeFiles": "{backend/tests/**,exemples/**,word/node_modules/**,node_modules/**,checkup360-front/**,supabase/**}"
    },
    "api/docx.js": {
      "maxDuration": 60,
      "includeFiles": "word/{fonts/**,logo.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!docx$).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "17 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://hhzwzoantzhgtsbrtswr.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/conseiller.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
